# API del dashboard de trading (NestJS). SOLO LECTURA de la BD y Redis del sistema.
# Copiar a .env y completar. El .env NUNCA se commitea.

NODE_ENV=development
PORT=3001
# Vacío si el front va por proxy (Vite en local, nginx en Dokploy). Si no: https://dashboard.tudominio.com
CORS_ORIGIN=

# --- Postgres del sistema (recomendado: usuario dashboard_ro, ver sql/usuario_solo_lectura.sql) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=dashboard_ro
POSTGRES_PASSWORD=<CAMBIAR>
POSTGRES_SSL=false

# --- Redis del sistema ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Qué se muestra (igual que config.yaml -> produccion.activos) ---
PAIRS=EUR_USD,USD_JPY,XAU_USD
GRANULARITY=H1
DISPLAY_TZ=America/Guayaquil
SIDE_STRATEGIES=prueba,practica

# --- Acceso (generar con: npm run hash-password) ---
AUTH_USERNAME=misael
AUTH_PASSWORD_HASH_B64=<CAMBIAR>
JWT_SECRET=<CAMBIAR>
SESSION_HOURS=12
# true en Dokploy (HTTPS); false en local (http)
COOKIE_SECURE=false
